
import java.util.Scanner;

class Student {
    int rollNo;
    String name;
    int m1, m2, m3;

    Student(int r, String n, int a, int b, int c) {
        rollNo = r;
        name = n;
        m1 = a;
        m2 = b;
        m3 = c;
    }

    void display() {
        int total = m1 + m2 + m3;
        float percentage = total / 3.0f;

        System.out.println("\n----- STUDENT MARKSHEET -----");
        System.out.println("Roll Number: " + rollNo);
        System.out.println("Name: " + name);
        System.out.println("Total Marks: " + total);
        System.out.println("Percentage: " + percentage);

        if (m1 >= 33 && m2 >= 33 && m3 >= 33) {
            System.out.println("Result: PASS");

            if (percentage >= 60) {
                System.out.println("Grade: First Division");
            } else if (percentage >= 45) {
                System.out.println("Grade: Second Division");
            } else {
                System.out.println("Grade: Third Division");
            }
        } else {
            System.out.println("Result: FAIL");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Roll Number: ");
        int r = sc.nextInt();

        sc.nextLine();
        System.out.print("Enter Name: ");
        String n = sc.nextLine();

        System.out.print("Enter marks of 3 subjects: ");
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();

        Student s = new Student(r, n, a, b, c);
        s.display();

        sc.close();
    }
}
